{
	"name": "lalasynth",
	"private": true,
	"version": "0.1.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome check .",
		"format:fix": "biome check . --write",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"autoprefixer": "^10.5.0",
		"postcss": "^8.5.13",
		"prettier": "^3.8.3",
		"tailwindcss": "^4.2.4",
		"turbo": "^2.9.7",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.3.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	}
