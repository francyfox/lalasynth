{
	"name": "@app/cli",
	"version": "0.1.0",
	"type": "module",
	"description": "A CLI built with Bunli",
	"author": "",
	"bin": {
		"cli": "./dist/index.js"
	},
	"scripts": {
		"postinstall": "bunli generate || true",
		"dev": "bun run src/index.ts",
		"build": "bunli build",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@bunli/core": "^0.9.1",
		"@app/api": "workspace:*"
	},
	"devDependencies": {
		"@bunli/test": "^0.6.0",
		"@types/bun": "^1.3.13",
		"bunli": "^0.9.1",
		"typescript": "^6.0.3",
		"zod": "^4.4.2"
	},
	"bunli": {
		"entry": "./src/index.ts",
		"outDir": "./dist"
	}
}
