NODE_ENV=production

# Frontend URL (web app)
CLIENT_URL=http://localhost:5173

# Audio storage
LOCAL_SONGS_DIR=./songs
LOCAL_SONGS_AUDIO_BITRATE_KBPS=128

# SQLite (local) — leave TURSO vars unset to use local SQLite
# TURSO_CONNECTION_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG_NAME=
# TURSO_DB_NAME=

# Public URL of this API (used for static asset URLs in responses)
# Defaults to http://localhost:PORT if not set
# API_URL=https://lala-api.example.com

# Cloudflare Tunnel token (optional, for exposing API via cloudflared)
# CLOUDFLARED_TOKEN=